# Business Logic Service
AUTH_SERVICE_URL=http://auth-service:8081
DATA_SERVICE_URL=http://data-service:8083
AUTH_VALIDATE_CACHE_TTL=60
TRACKIT_TZ=Europe/Bucharest

# Data Service (used by the local compose stack)
DATA_DB_USER=data_user
DATA_DB_PASSWORD=changeme

# Auth Service (used by the local compose stack)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=changeme
AUTH_JWT_SECRET=changeme
AUTH_JWT_ACCESS_TTL=900
AUTH_JWT_REFRESH_TTL=604800
